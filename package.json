{
  "name": "webapp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "vite --port=3001",
    "build": "vite build",
    "serve": "vite preview",
    "start": "vite",
    "test": "vitest",
    "e2e": "playwright test",
    "e2e:debug": "playwright test --headed --debug",
    "e2e:ui": "playwright test --ui",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/ui": "^4.1.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-sql": "^6.10.0",
    "@tanstack/react-query": "^5.101.4",
    "@uiw/codemirror-theme-github": "^4.25.11",
    "@uiw/react-codemirror": "^4.25.11",
    "fts5-sql-bundle": "^1.0.2",
    "google-palette": "^1.1.1",
    "jotai": "^2.20.2",
    "papaparse": "^5.5.4",
    "rc-resize-observer": "^1.4.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sql.js-httpvfs": "^0.8.12",
    "use-navigation-api": "^0.6.0",
    "wa-sqlite": "^1.0.0"
  },
  "prettier": {
    "printWidth": 100,
    "bracketSameLine": true
  },
  "lint-staged": {
    "*.{js,css,md}": "prettier --write"
  }
}
